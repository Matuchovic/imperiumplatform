# --- Session ---
# openssl rand -base64 32
AUTH_SECRET=""

# --- Supabase ---
# Project Settings → API Keys
# anon / publishable — smí do prohlížeče, chrání ho RLS
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# service_role / secret — NIKDY s prefixem NEXT_PUBLIC_, nikdy do commitu.
# Obchází RLS. Používá ho jen motor na serveru.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Kurzy ---
ODDS_PROVIDER="sportsgameodds"
ODDS_API_KEY=""
ENGINE_LEAGUES="EPL,NBA,NHL"

# --- Cron ---
# openssl rand -hex 32
CRON_SECRET=""

# --- AI (jen jazykové úlohy: parsování textu, návrhy zpráv, briefingy) ---
# Hodnotu tiketů nepočítá model, ale lib/engine. Bez klíče appka funguje,
# jen bez rychlého zadání a bez podkladů k hovoru.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Automatické zúčtování ---
# Bez klíče se nic nezúčtuje. Otevřený tiket je lepší než vymyšlený výsledek.
RESULTS_API_KEY=
